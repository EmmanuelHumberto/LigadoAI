{
  "servers": [
    {
      "name": "ligadoai_fs",
      "transport": "stdio",
      "command": "/home/hiatus/.local/bin/uv",
      "args": ["run", "--directory", "/home/hiatus/Projetos/ligadotattoo/opentracy-terminal-chat", "python", "-m", "ligadoai_tools.filesystem_server"],
      "env": {
        "LIGADOAI_ALLOWED_READ_DIRS": "~/LigadoAI",
        "LIGADOAI_MAX_FILE_SIZE": "10485760",
        "LIGADOAI_MAX_OUTPUT_BYTES": "65536"
      },
      "enabled": true,
      "description": "Ferramentas read-only para arquivos autorizados e data/hora."
    },
    {
      "name": "ligadoai_search",
      "transport": "stdio",
      "command": "/home/hiatus/.local/bin/uv",
      "args": ["run", "--directory", "/home/hiatus/Projetos/ligadotattoo/opentracy-terminal-chat", "python", "-m", "ligadoai_tools.search_server"],
      "env": {
        "LIGADOAI_ALLOWED_READ_DIRS": "~/LigadoAI",
        "LIGADOAI_MAX_OUTPUT_BYTES": "65536",
        "LIGADOAI_MAX_SEARCH_RESULTS": "50"
      },
      "enabled": true,
      "description": "Ferramentas de busca em arquivos (search_files, grep)."
    }
  ]
}
